{
  "name": "rakkydashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3015",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3015",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "sync:brand": "node --experimental-strip-types scripts/sync-brand.ts",
    "test:session": "node --experimental-strip-types scripts/session-smoke.ts",
    "test:rider": "node --experimental-strip-types scripts/rider-smoke.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:session && npm run test:rider"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
