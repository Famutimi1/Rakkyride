# Development fixtures are opt-in and rejected when NODE_ENV=production.
DASHBOARD_PREVIEW=false
# Shared existing Express backend; privileged tokens stay in HttpOnly cookies.
RAKKY_API_URL=http://127.0.0.1:4000
# Public Google OAuth web client ID; must match backend GOOGLE_CLIENT_ID_WEB.
# Authorize the exact dashboard origin in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional browser-restricted key, with Maps Embed API enabled.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Explicit label; must match the connected backend configuration.
RAKKY_ENVIRONMENT=test

# Required exact origin for session CSRF checks; use the HTTPS site URL in production.
DASHBOARD_ORIGIN=http://127.0.0.1:3015

# Maps JavaScript API enabled; restrict this browser key to dashboard origins.
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Remains false until provider tests and commercial limits are approved.
ENABLE_ADMIN_MONEY_ACTIONS=false

# Configuration edits require a super_admin session and an audited confirmation.

# Optional published store listings on the public /open-app page.
# Android: full https://play.google.com/store/apps/details?id=YOUR_PACKAGE URL.
# iOS: full https://apps.apple.com/... URL. Leave empty until published.
RAKKY_ANDROID_STORE_URL=
RAKKY_IOS_STORE_URL=
